rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isTeacher() {
      return signedIn() && request.auth.token.email == 'ustoz@maktab-dbd09.firebaseapp.com';
    }
    match /students/{id} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }
    match /config/{id} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }
    match /timetable/{id} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }
    match /chat/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','sid','name','t','kind','text','img','w','h','voice','dur','reply','reactions'])
        && request.resource.data.kind in ['text','img','voice','sticker']
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && (!('img' in request.resource.data) || (request.resource.data.img is string && request.resource.data.img.size() <= 300000))
        && (!('voice' in request.resource.data) || (request.resource.data.voice is string && request.resource.data.voice.size() <= 300000))
        && (request.resource.data.sid != 'teacher' || isTeacher());
      allow update: if signedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions is map
          && request.resource.data.reactions.size() <= 12)
        || (resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','edited'])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000));
      allow delete: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    match /typing/{sid} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.data.keys().hasOnly(['name','t','uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && (sid != 'teacher' || isTeacher());
    }
  }
}
